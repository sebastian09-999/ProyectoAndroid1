<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F3F7"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login Profesional"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <!-- Correo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico:"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <EditText
                    android:id="@+id/etCorreoProfesional"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="Correo electrónico"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true" />

                <!-- Contraseña -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contraseña:"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <EditText
                    android:id="@+id/etContrasenaProfesional"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true" />

                <!-- Número de documento -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Número de documento:"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <EditText
                    android:id="@+id/etNumDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="Número de documento"
                    android:inputType="number"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true" />

                <!-- Credencial profesional -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Credencial profesional:"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <EditText
                    android:id="@+id/etCredencial"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="Credencial profesional"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true" />

                <!-- Adjuntar archivo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Adjuntar archivo:"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <FrameLayout
                    android:id="@+id/btnAdjuntarArchivo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tvNombreArchivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adjuntar archivo"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:layout_gravity="center_vertical|start" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_send"
                        android:layout_gravity="center_vertical|end" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="28dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIniciarSesion"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="INICIAR SESIÓN"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#4C75FF"
                        app:cornerRadius="14dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAtras"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Atrás"
                        android:textColor="#4C75FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:strokeColor="#4C75FF"
                        app:strokeWidth="1dp"
                        app:cornerRadius="14dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRecuperarContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recuperar contraseña"
                    android:textColor="#4C75FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</FrameLayout>
