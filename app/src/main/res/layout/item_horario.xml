<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Fila Superior: Día y Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lunes"
                android:textColor="@color/primary_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Botón Editar -->
            <ImageView
                android:id="@+id/btnEditar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/primary" />

            <!-- Botón Eliminar -->
            <ImageView
                android:id="@+id/btnEliminar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#EF4444" />
        </LinearLayout>

        <!-- Texto de Vigencia -->
        <TextView
            android:id="@+id/tvVigencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Vigencia: 19 Nov 2026 - 30 Nov 2026"
            android:textColor="@color/text_light"
            android:textSize="14sp" />

        <!-- Fila de Etiquetas (Horas y Citas) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Tag Horas -->
            <TextView
                android:id="@+id/tvHoras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F1F5F9"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="08:00 AM - 05:00 PM"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"/>

            <!-- Tag Citas -->
            <TextView
                android:id="@+id/tvCitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F1F5F9"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Máx. 5 citas/día"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>